{
  "devDependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fortawesome/fontawesome-free": "^6.4.0",
    "cssnano": "^9.9.0",
    "postcss": "^8.5.33",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "tailwindcss": "^3.4.19"
  },
  "private": true,
  "scripts": {
    "build:css": "npm run build:tailwind && node scripts/build-styles.cjs",
    "build": "npm run build:icons && npm run build:css",
    "build:tailwind": "tailwindcss -c tailwind.config.cjs -i css/tailwind-input.css -o css/tailwind.min.css --minify",
    "optimize:images": "node scripts/optimize-images.cjs",
    "optimize:responsive": "node scripts/responsive-images.cjs",
    "build:icons": "node scripts/build-icons.cjs"
  }
}
